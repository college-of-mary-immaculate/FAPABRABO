  "name": "It Takes Two",
  "genre": "[\"Adventure Games\",\"Action\",\"Adventure\"]",
  "tags": "[\"Co-op\",\"Multiplayer\",\"Split Screen\",\"Local Co-Op\",\"Online Co-Op\",\"Puzzle\",\"Adventure\",\"Story Rich\",\"Co-op Campaign\",\"Local Multiplayer\",\"Puzzle Platformer\",\"Action-Adventure\",\"3D Platformer\",\"Emotional\",\"Platformer\",\"Action\",\"Exploration\",\"Atmospheric\",\"Minigames\",\"Female Protagonist\"]",
  "publisher": "Electronic Arts",
