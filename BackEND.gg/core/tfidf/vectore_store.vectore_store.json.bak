{
  "_id": {
    "$oid": "68e81b4d967c07aa12681665"
  },
  "name": "Through the Ages",
  "genre": "[\"Strategy\",\"Board Games\",\"Indie\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Multiplayer\",\"Atmospheric\",\"steam-trading-cards\",\"2D\",\"Free to Play\",\"Online multiplayer\",\"Tactical\",\"Retro\",\"Cross-Platform Multiplayer\",\"Turn-Based\",\"Replay Value\",\"3D\",\"Realistic\",\"Cinematic\",\"Historical\",\"Turn-Based Strategy\",\"Competitive\",\"Visual Novel\",\"Linear\",\"1990's\",\"Stylized\",\"Resource Management\",\"Economy\",\"Card Game\",\"Grand Strategy\",\"Soundtrack\",\"Board Game\",\"Old School\",\"Politics\",\"Software\",\"Steam Turn Notifications\"]",
  "publisher": "CGE Digital",
  "description": "Through The Ages is a 17 minute real-time high end graphical cinematic that takes us on a nostalgic journey through three of NVIDIA's iconic GPUs in unprecedended visual detail.Featuring visuals that push the NVIDIA RTX 4090 to its limits, Through The Ages employs Nanite assets with up to 122 million polygons with the latest in NVIDIA technologies including ReSTIR Global Illumination, RTX Direct Illumination, Enhanced RayTraced Translucency, Real-Time RayTraced Caustics, Shader Execution Reordering and DLSS. This tech demo was created as a personal project in collaboration with NVIDIA & Maingear who provided hardware to make this project possibleThrough The Ages uses the Unreal® Engine. Unreal® is a trademark or registered trademark of Epic Games, Inc. in the United States of America and elsewhere.Unreal® Engine, Copyright 1998 – 2025, Epic Games, Inc. All rights reserved.Show less",
  "url": "https://rawg.io/games/through-the-ages",
