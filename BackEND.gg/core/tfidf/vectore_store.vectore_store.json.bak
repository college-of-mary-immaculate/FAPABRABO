{
  "_id": {
    "$oid": "68e81b4d967c07aa126815be"
  },
  "name": "Katana ZERO",
  "genre": "[\"Action\",\"Indie\",\"Platformer\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Full controller support\",\"Great Soundtrack\",\"2D\",\"Pixel Graphics\",\"Retro\",\"combat\",\"Cyberpunk\",\"Story\",\"death\",\"Traps\",\"dodge\",\"dash\"]",
  "publisher": "Devolver Digital",
  "description": "Katana ZERO is a fast paced neo-noir action platformer, focusing on tight, instant-death acrobatic combat, and a dark 80's neon aesthetic. Aided with your trusty katana, the time manipulation drug Chronos and the rest of your assassin's arsenal, fight your way through a fractured city, and take back what's rightfully yours. Run, sneak, walljump, grapple hook, roll, slash bullets, toss pottery, and slow down time to complete levels. No procedural generation. No backtracking. No metroidvania gimmicks or item collection. Every level is a unique and lovingly designed challenge to overcome. A rich story filled with unique characters, all tied into the gameplay and level design.Show less",
  "url": "https://rawg.io/games/katana-zero",
  "image": "https://media.rawg.io/media/games/d37/d37e110ddcc0bd52d99f0f647b737a0a.jpg",
