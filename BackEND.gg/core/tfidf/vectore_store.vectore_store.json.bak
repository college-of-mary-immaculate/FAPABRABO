  "genre": "[\"Action\",\"Adventure\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Full controller support\",\"Steam Cloud\",\"Atmospheric\",\"Story Rich\",\"Third Person\",\"Sci-fi\",\"Horror\",\"Gore\",\"Difficult\",\"Action-Adventure\",\"Third-Person Shooter\",\"Dark\",\"Survival Horror\",\"Post-apocalyptic\",\"Crafting\",\"combat\",\"Futuristic\",\"Dystopian\",\"Resource Management\",\"Family Sharing\",\"Time Travel\",\"Постапокалипсис\",\"HDR available\"]",
  "publisher": "Bloober Team",
  "description": "Cronos: The New Dawn is a pulse-pounding, third-person survival horror game where time is your deadliest weapon — and your worst enemy. Survive a brutal future, dive back in time, and stop nightmarish creatures from merging into unstoppable abominations.",
