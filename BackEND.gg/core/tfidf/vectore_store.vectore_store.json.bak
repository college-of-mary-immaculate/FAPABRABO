  "genre": "[\"Adventure Games\",\"Action\",\"Adventure\",\"Indie\"]",
  "tags": "[\"Adventure\",\"Action\",\"Action-Adventure\",\"Souls-like\",\"Female Protagonist\",\"Exploration\",\"3D Platformer\",\"Third Person\",\"Cinematic\",\"Fantasy\",\"Atmospheric\",\"Magic\",\"3D\",\"Nature\",\"Story Rich\",\"Combat\",\"Singleplayer\",\"Controller\",\"Indie\",\"Mystery\"]",
