{
  "_id": {
    "$oid": "68e81b4d967c07aa12681463"
  },
  "name": "Superliminal",
  "genre": "[\"Indie\",\"Puzzle\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Full controller support\",\"First-Person\",\"puzzles\",\"box\"]",
  "publisher": "Pillow Castle Games",
  "description": "This is a single player first-person puzzle game that uses perception as a mechanic. You play as someone who wakes up in surprisingly lucid dream. As you complete puzzles to get to the next exit, certain patterns and truths become more apparent. In this game, everything is exactly what it seems to be! Wait, no...that's not right. Everything is the opposite of what you think it is? That's not correct either. This is a game about breaking expectations and thinking outside the box.",
  "url": "https://rawg.io/games/superliminal",
  "image": "https://media.rawg.io/media/screenshots/eca/eca35ae10f6e934ca79b7dc17ff71b23.jpg",
