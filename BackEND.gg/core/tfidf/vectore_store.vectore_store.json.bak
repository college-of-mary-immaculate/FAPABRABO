  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Atmospheric\",\"Great Soundtrack\",\"RPG\",\"Story Rich\",\"Open World\",\"Sci-fi\",\"Partial Controller Support\",\"Fantasy\",\"Exploration\",\"Classic\",\"Retro\",\"role-playing\",\"Turn-Based\",\"Turn-Based Strategy\",\"Cyberpunk\",\"Dystopian\",\"JRPG\",\"1990's\",\"Party-Based RPG\"]",
