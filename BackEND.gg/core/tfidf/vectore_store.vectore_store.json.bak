  "name": "TAKEUMA 2D",
  "genre": "[\"Action Games\",\"Action\",\"Adventure\",\"Indie\"]",
  "tags": "[\"Action\",\"Adventure\",\"Action-Adventure\",\"2D Platformer\",\"Exploration\",\"Side Scroller\",\"Pixel Graphics\",\"Fantasy\",\"Retro\",\"Indie\",\"Nature\",\"PvE\",\"Singleplayer\",\"2D\"]",
