  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Multiplayer\",\"Full controller support\",\"Steam Cloud\",\"Atmospheric\",\"Co-op\",\"Story Rich\",\"cooperative\",\"Funny\",\"Split Screen\",\"Action-Adventure\",\"Controller\",\"Early Access\",\"Family Friendly\",\"Cute\",\"3D\",\"Colorful\",\"3D Platformer\",\"Cartoony\",\"Emotional\",\"Remote Play Together\",\"nature\",\"Shared/Split Screen Co-op\",\"cats\",\"Котики\"]",
