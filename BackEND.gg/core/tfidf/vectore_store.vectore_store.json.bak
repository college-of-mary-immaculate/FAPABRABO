  "name": "skate.",
  "genre": "[\"Free To Play Games\",\"Action\",\"Sports\",\"Free To Play\",\"Early Access\"]",
  "tags": "[\"Action\",\"Multiplayer\",\"Skateboarding\",\"Free to Play\",\"Character Customization\",\"Controller\",\"Online Co-Op\",\"Sports\",\"Sandbox\",\"Third Person\",\"Early Access\",\"Parkour\",\"Skating\",\"Funny\",\"Simulation\",\"Exploration\",\"Realistic\",\"Immersive Sim\",\"Physics\",\"PvP\"]",
  "publisher": "Electronic Arts",
  "description": "Experience improved Flick-It controls, the rich physics based skateboarding gameplay that provides those “only in skate.™“ moments and off-board exploration for full freedom in the online multiplayer world of San Vansterdam.",
