  "name": "Tales of the Shire: A The Lord of The Rings™ Game",
  "genre": "[\"Simulation Games\",\"Casual\",\"Indie\",\"RPG\",\"Simulation\"]",
  "tags": "[\"Life Sim\",\"Cozy\",\"Character Customization\",\"Farming Sim\",\"Casual\",\"Indie\",\"Nature\",\"Cooking\",\"3D\",\"Cute\",\"Third Person\",\"Simulation\",\"LGBTQ+\",\"Story Rich\",\"Fantasy\",\"Colorful\",\"Singleplayer\",\"RPG\",\"Crafting\",\"Management\"]",
  "publisher": "Private Division",
  "description": "Welcome home, Hobbit! Live the cosy life of a Hobbit in the wonderfully serene landscape of the Shire. Discover, decorate, &amp; share in this idyllic corner of Middle-earth. Join friendly Hobbits &amp; familiar faces awaiting your arrival in Tales of the Shire: A The Lord of the Rings™ Game.",
  "url": "https://store.steampowered.com/app/2016460/Tales_of_the_Shire_A_The_Lord_of_The_Rings_Game?snr=1_241_4_nature_salesmartpopularpurchased",
