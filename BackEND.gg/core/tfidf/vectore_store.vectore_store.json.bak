{
  "_id": {
    "$oid": "68e81b4e967c07aa126816b7"
  },
  "name": "BATTLESHIP",
  "genre": "[\"Action\",\"Shooter\",\"RPG\",\"Strategy\",\"Simulation\",\"Board Games\",\"Casual\",\"Family\"]",
  "tags": "[\"Singleplayer\",\"Multiplayer\",\"RPG\",\"Third Person\",\"Action RPG\",\"Realistic\",\"Shoot 'Em Up\",\"Bullet Hell\",\"Board Game\",\"Battle Royale\",\"Wargame\"]",
  "publisher": "Ubisoft Entertainment",
  "description": "A modern Naval warfare game with optional air strikes from allied planes. The Player controls a military ship on the open ocean. Once the game begins, an enemy ship will appear on the horizon. The goal of the game is for the Player to sink as many enemy ships as possible. When the Player successfully sinks an enemy ship, a new enemy ship will appear on the horizon. To sink an enemy ship, the Player can either send missiles from his ship, or engage an allied plan from the sky above. The pressure is on as all this time, the enemy ship is sending missiles towards the Player's ship, in an attempt to sink it. Every time the Player sinks an enemy ship, he gains a point. The Player's points are saved and tallied in the top left corner of the screen. When the Player's ship is sunk by an enemy ship, the game ends and the Player can either restart the game or quit. In either case, the Player's high score is saved and appears at the top left of the screen.Show less",
  "url": "https://rawg.io/games/battleship",
  "image": "https://media.rawg.io/media/screenshots/57a/57ad4ceeae55873c06f0002a1c19ce8f.jpg",
