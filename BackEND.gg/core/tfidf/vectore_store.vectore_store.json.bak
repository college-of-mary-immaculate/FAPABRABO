{
  "_id": {
    "$oid": "68e81b4e967c07aa126817bd"
  },
  "name": "Shape of Dreams",
  "genre": "[\"Action\",\"Adventure\",\"RPG\",\"Indie\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Multiplayer\",\"Full controller support\",\"Steam Cloud\",\"Atmospheric\",\"Co-op\",\"cooperative\",\"Online Co-Op\",\"Fantasy\",\"Exploration\",\"Difficult\",\"Space\",\"Hack and Slash\",\"Dark Fantasy\",\"Futuristic\",\"Roguelike\",\"Roguelite\",\"Dungeon Crawler\",\"Surreal\",\"Family Sharing\",\"Score Attack\",\"Action Roguelike\"]",
  "publisher": "NEOWIZ",
  "description": "Become the Nightmare. Master the dream. Shatter reality. Shape of Dreams is a fast-paced action roguelite that fuses hack-and-slash combat, MOBA-style teamplay, and endless strategic variety. Journey through surreal dreamscapes where every battle tests your reflexes and every choice shapes your fate. Play solo for a tight, skill-based challenge or team up with up to three friends in real-time co-op, improvising distinct combat styles and forging powerful builds that can turn you into the nightmare your enemies fear. Here, the dream bends to those strong… Read more",
  "url": "https://rawg.io/games/shape-of-dreams-2",
  "image": "https://media.rawg.io/media/screenshots/dbf/dbfe464916507eaefd40ebf79695036f.jpg",
