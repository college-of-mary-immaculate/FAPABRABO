{
  "_id": {
    "$oid": "68e81b4d967c07aa12681684"
  },
  "name": "Lost Cities",
  "genre": "[\"Strategy\",\"Board Games\",\"Casual\",\"Card\",\"Indie\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Multiplayer\",\"Full controller support\",\"steam-trading-cards\",\"Steam Leaderboards\",\"Online multiplayer\",\"Split Screen\",\"Local Multiplayer\",\"stats\",\"Cross-Platform Multiplayer\",\"exclusive\",\"Turn-Based Strategy\",\"Card Game\",\"Board Game\",\"Steam Turn Notifications\"]",
  "publisher": "BlueLine Games",
  "description": "Officially licensed version of the award winning Lost Cities by Reiner Knizia. In Lost Cities, you play the part of an adventurer searching for forgotten cities around the globe. Plan your expeditions wisely to outpace your rival's pursuits! Feeling confident? Place a wager on an expedition that you think you can master. After 3 rounds of adventuring, the player that had the most successful expeditions is the winner! Features: Play locally or online. Play against the Computer - AI with five difficulty levels. Includes \"hot-seat\"/\"pass-n-play\" mode for players with who want to share one mouse/keyboard or gamepad. Switch seamlessly between playing with mouse/keyboard and gamepad. Dozens of Steam Stats & Achievements. Asynchronous play - you can play even when your opponent is offline.Show less",
  "url": "https://rawg.io/games/lost-cities",
  "image": "https://media.rawg.io/media/screenshots/86d/86d83b5e068f1eb51e6b41564ff85470.jpeg",
