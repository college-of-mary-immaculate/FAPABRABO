{
  "_id": {
    "$oid": "68e81b4d967c07aa12681499"
  },
  "name": "Return",
  "genre": "[\"Adventure\",\"RPG\",\"Indie\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Full controller support\",\"Atmospheric\",\"RPG\",\"Story Rich\",\"2D\",\"Sci-fi\",\"Horror\",\"Fantasy\",\"Exploration\",\"Difficult\",\"Pixel Graphics\",\"Controller\",\"Dark\",\"Space\",\"Hack and Slash\",\"Post-apocalyptic\",\"Side Scroller\",\"Aliens\",\"VR\",\"Dystopian\",\"Shoot 'Em Up\",\"Stylized\",\"PvE\",\"city\",\"friends\",\"Soundtrack\",\"Souls-like\",\"fight\",\"weapons\",\"secrets\",\"Постапокалипсис\",\"journey\",\"planet\",\"3D Fighter\",\"3D-файтинг\",\"survive\",\"Escape Room\",\"search\",\"enemies\",\"VR Only\",\"points\"]",
  "publisher": "Dead Unicorn",
  "description": "Return; \"Solve or Die\" Escape Space Station, Puzzle, Shooting VR Game. Defeat aliens and solve puzzles to escape to Earth in a contaminated space station! How to Play You can select a button in the play screen by pressing the trigger button on the VR controller. You can check the operation method by pressing the A button on the VR controller. Introduce Developers Yeni, TG Lee, Seyoung Yang This VR game was created by three friends using UnrealEngine5 for about 7 weeks. We hope you enjoy playing our game! (Waiting for Update Approval) … Read more",
  "url": "https://rawg.io/games/return-5",
