  "tags": "[\"Singleplayer\",\"Multiplayer\",\"RPG\",\"Co-op\",\"Open World\",\"First-Person\",\"Partial Controller Support\",\"FPS\",\"Exploration\",\"Steam Leaderboards\",\"Sandbox\",\"Survival\",\"Free to Play\",\"Early Access\",\"stats\",\"Steam Workshop\",\"PvP\",\"Includes level editor\",\"Crafting\",\"Dragons\",\"Dinosaurs\"]",
  "publisher": "Studio Wildcard",
