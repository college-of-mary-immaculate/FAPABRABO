{
  "_id": {
    "$oid": "68e81b4d967c07aa1268165b"
  },
  "name": "One Deck Dungeon",
  "genre": "[\"Adventure\",\"RPG\",\"Strategy\",\"Board Games\",\"Card\",\"Indie\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Steam Cloud\",\"steam-trading-cards\",\"RPG\",\"Co-op\",\"cooperative\",\"Steam Leaderboards\",\"Female Protagonist\",\"Split Screen\",\"Local Co-Op\",\"Local Multiplayer\",\"Early Access\",\"stats\",\"Roguelite\",\"Card Game\",\"Board Game\"]",
  "publisher": "Handelabra Games",
  "description": "Adventure calls... but you don't always have time to spend hours optimizing your character sheet or managing your inventory! One Deck Dungeon lets you jump right in to bashing down doors, rolling dice, and squashing baddies with style. Get a full roguelike game experience, boiled down to its essence, and captured in a single deck of cards and a handful of dice! One Deck Dungeon is a dungeon crawling adventure game for one or two players. Each time you play, choose one or two of these 5 brave heroes: Mage - There's rarely a problem… Read more",
  "url": "https://rawg.io/games/one-deck-dungeon",
  "image": "https://media.rawg.io/media/screenshots/468/46819eab6c9b61a68dee31c1f5da73fb.jpg",
