  "tags": "[\"Life Sim\",\"Free to Play\",\"Character Customization\",\"Building\",\"Romance\",\"Simulation\",\"Singleplayer\",\"Sandbox\",\"Dating Sim\",\"Relaxing\",\"Casual\",\"Realistic\",\"Funny\",\"Family Friendly\",\"Cute\",\"Immersive Sim\",\"Fantasy\",\"Adventure\",\"Cartoony\",\"Nudity\"]",
