  "genre": "[\"Action\",\"Shooter\",\"Adventure\",\"RPG\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Steam Cloud\",\"Atmospheric\",\"RPG\",\"Story Rich\",\"Open World\",\"First-Person\",\"Sci-fi\",\"Partial Controller Support\",\"FPS\",\"Exploration\",\"Survival\",\"Moddable\",\"Post-apocalyptic\",\"Choices Matter\",\"Realistic\",\"Cinematic\",\"Multiple Endings\",\"Steam Trading Cards\",\"Lore-Rich\",\"Family Sharing\",\"Immersive Sim\",\"Nonlinear\",\"Постапокалипсис\",\"HDR available\",\"choices matter\"]",
  "publisher": "SEGA",
