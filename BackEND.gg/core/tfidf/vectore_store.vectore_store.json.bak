{
  "_id": {
    "$oid": "68e81b4e967c07aa1268192d"
  },
  "name": "Kingdom: Two Crowns",
  "genre": "[\"Adventure\",\"RPG\",\"Strategy\",\"Simulation\",\"Indie\"]",
  "tags": "[\"Singleplayer\",\"Full controller support\",\"Atmospheric\",\"Great Soundtrack\",\"Co-op\",\"Open World\",\"cooperative\",\"2D\",\"Online Co-Op\",\"Fantasy\",\"Exploration\",\"Survival\",\"Split Screen\",\"Local Co-Op\",\"Pixel Graphics\",\"Controller\",\"role-playing\",\"Side Scroller\",\"Roguelike\",\"Medieval\",\"Building\",\"Base Building\",\"Tower Defense\"]",
  "publisher": "Raw Fury",
  "description": "In the award-winning Kingdom series, players took on the role of a monarch struggling to build their kingdom up from nothing. Hundreds of thousands of players across the world explored, recruited loyal subjects, and defended nightly against the persistent threat of the Greed – but they did so in isolation, and as with all things in Kingdom, nothing lasts… until now. Kingdom Two Crowns builds upon the challenging micro strategy experience with an evolution of the celebrated franchise. Introducing the brand-new campaign mode, monarchs must now work to build a kingdom that stands over… Read more",
  "url": "https://rawg.io/games/kingdom-two-crowns",
