  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Full controller support\",\"Steam Cloud\",\"Atmospheric\",\"Story Rich\",\"Sci-fi\",\"Horror\",\"Exploration\",\"Female Protagonist\",\"Survival\",\"Anime\",\"Post-apocalyptic\",\"Mystery\",\"3D\",\"Cinematic\",\"Futuristic\",\"Aliens\",\"Walking Simulator\",\"Multiple Endings\",\"Visual Novel\",\"Surreal\",\"Music\",\"Протагонистка\",\"Family Sharing\",\"Thriller\",\"Experimental\",\"history\",\"Narrative\",\"future\",\"Постапокалипсис\",\"interactive\",\"memory\",\"dance\",\"Neon\",\"beach\",\"garden\",\"shape\"]",
  "publisher": "Fellow Traveller",
