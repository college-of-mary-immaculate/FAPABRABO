  "tags": "[\"Casual\",\"Local Multiplayer\",\"Multiplayer\",\"Beat 'em up\",\"4 Player Local\",\"Split Screen\",\"Singleplayer\",\"Precision Platformer\",\"Battle Royale\",\"Action\",\"Controller\",\"Side Scroller\",\"PvP\",\"Pixel Graphics\",\"2D Platformer\",\"Platformer\",\"Indie\",\"2D\",\"Violent\",\"Funny\"]",
