  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"Full controller support\",\"Steam Cloud\",\"Atmospheric\",\"Story Rich\",\"2D\",\"Exploration\",\"Pixel Graphics\",\"Dark\",\"Point & Click\",\"Mystery\",\"Choices Matter\",\"Historical\",\"Crime\",\"Detective\",\"Interactive Fiction\",\"Thriller\",\"Conspiracy\",\"Investigation\",\"Narrative\"]",
