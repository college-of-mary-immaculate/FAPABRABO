  "name": "Lazors",
  "genre": "[\"Board Games\",\"Casual\",\"Indie\",\"Puzzle\"]",
  "tags": "[\"Singleplayer\",\"Steam Achievements\",\"steam-trading-cards\"]",
  "publisher": "Pyrosphere",
  "description": "Lazors is a puzzle game of lasers and mirrors, for players who enjoy thoughtful and reflective experiences. Lots of levels, over 200, that start easy but become quite challenging! Intuitive gameplay - just drag the blocks to reflect the lasers and hit all targets. Several types of blocks that interact with the lasers in different ways, such as mirrors and portals. Stuck? You can always use a hint - it will move a block to its correct position, helping you solve the level without giving the solution away.",
  "url": "https://rawg.io/games/lazors",
  "image": "https://media.rawg.io/media/screenshots/81d/81db1b8b5659e4875b2bb20c785e28c9.jpg",
